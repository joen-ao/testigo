# TESTIGO+ environment. Copy to .env and fill in. Never commit .env.
# Every variable the code reads is listed here; a test keeps the two in sync.

# --- Meta API (OpenAI-SDK compatible). Each person uses their own key. ---
# Host of the Meta API (decision D2: value from the participant docs).
META_API_BASE_URL=
# Your personal key. Do not share it over chat or email.
META_API_KEY=
# Model ids (decision D2).
META_MODEL_WONDER=
META_MODEL_SPARK=
META_MODEL_SAM=
META_MODEL_VOICE=

# --- Local Glimmer, optional (only with a 24 GB GPU) ---
GLIMMER_BASE_URL=
GLIMMER_MODEL=

# --- Local services ---
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
INTERCEPTOR_HOST=127.0.0.1
INTERCEPTOR_PORT=8090
# WebAuthn needs a domain: localhost, not an IP address.
UI_ORIGIN=http://localhost:8090
WEBAUTHN_RP_ID=localhost
# Leave empty: `make setup` generates it. Only the scoring script uses it.
SCORER_TOKEN=

# --- Signing and evidence ---
SIGNING_KEY_PATH=.secrets/receipts.key
RUNS_DIR=runs

# --- Spend cap (example value). The Meta client stops when it is reached. ---
MAX_SPEND_USD=20
